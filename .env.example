# Gratter Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# Convex (Backend) - REQUIRED
# =============================================================================
# Get these from your Convex dashboard: https://dashboard.convex.dev
# After running `npx convex dev`, it will create a .env.local with these values
CONVEX_DEPLOYMENT=dev:your-deployment-name
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# =============================================================================
# AI Generation (OpenRouter) - OPTIONAL
# =============================================================================
# Get a free API key from https://openrouter.ai
# If not set, Gratter will use a deterministic mock study kit generator
AI_API_KEY=your-openrouter-api-key
# Alternative variable name (also works)
# OPENROUTER_API_KEY=your-openrouter-api-key

# Base URL for OpenRouter API (usually don't need to change)
AI_BASE_URL=https://openrouter.ai/api/v1

# Model to use for study kit generation
# Free tier models: deepseek/deepseek-chat-v3-0324:free, meta-llama/llama-3.2-3b-instruct:free
# Paid models: openai/gpt-4o-mini, anthropic/claude-3.5-sonnet
AI_MODEL=deepseek/deepseek-chat-v3-0324:free

# =============================================================================
# Email OTP (Convex Auth) - REQUIRED for email auth
# =============================================================================
# Get these from Resend (https://resend.com) or any SMTP provider
# These are used by Convex Auth for email OTP
EMAIL_OTP_RESEND_API_KEY=re_your-resend-api-key
EMAIL_OTP_FROM_EMAIL=noreply@yourdomain.com
EMAIL_OTP_FROM_NAME=Gratter

# =============================================================================
# Site URL (for auth callbacks)
# =============================================================================
# Development
SITE_URL=http://localhost:5173
# Production (update when deploying)
# SITE_URL=https://your-domain.com

# =============================================================================
# JWT Keys (Convex Auth) - Auto-generated by Convex
# =============================================================================
# These are managed by Convex. Don't modify manually unless you know what you're doing.
# JWKS={"keys":[...]}
# JWT_PRIVATE_KEY=...